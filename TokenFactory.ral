Contract TokenFactory(
  tokenTemplateId: ByteVec  // the template contract id of `Token`
) {
  event TokenCreated(
    creator: Address,
    tokenId: ByteVec,
    name: ByteVec,
    symbol: ByteVec,
    totalSupply: U256
  )

  @using(preapprovedAssets = true, checkExternalCaller = false)
  pub fn createToken(
    creator: Address,
    name: ByteVec,
    symbol: ByteVec,
    decimals: U256,
    totalSupply: U256,
    alphAmount: U256  // ALPH for the contract deposit (min 1 ALPH typically)
  ) -> ByteVec {
    // Encode the immutable + mutable fields of the Token contract
    let (encodedImmFields, encodedMutFields) = Token.encodeFields!(
      symbol,
      name,
      decimals,
      totalSupply,
      creator
    )

    // Deploy the Token as a sub-contract, attaching `totalSupply` of a new token
    // whose ID will be the sub-contract's ID.
    let tokenId = copyCreateSubContractWithToken!{creator -> ALPH: alphAmount}(
      name,                    // sub-contract name (must be unique per factory)
      tokenTemplateId,
      encodedImmFields,
      encodedMutFields,
      totalSupply              // <- this many tokens get issued to the sub-contract
    )

    emit TokenCreated(creator, tokenId, name, symbol, totalSupply)
    return tokenId
  }
}
